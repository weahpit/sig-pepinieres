{{ form_start(form) }}
<div class="row g-3">
    <div class="col-md-4">{{ form_row(form.numeroLot) }}</div>
    <div class="col-md-4">{{ form_row(form.pepiniere) }}</div>
    <div class="col-md-4">{{ form_row(form.espece) }}</div>
    <div class="col-md-4">{{ form_row(form.planche) }}</div>
    <div class="col-md-4">{{ form_row(form.lotSemence) }}</div>
    <div class="col-md-4">{{ form_row(form.dateSemis) }}</div>
    <div class="col-md-4">{{ form_row(form.nbGrainesSemees) }}</div>
    <div class="col-md-4">{{ form_row(form.dateGermination) }}</div>
    <div class="col-md-4">{{ form_row(form.nbPlantsLeves) }}</div>
    <div class="col-md-4">{{ form_row(form.dateSortie) }}</div>
</div>
<div class="mt-3">
    <button class="btn btn-success"><i class="bi bi-check-lg"></i> Enregistrer</button>
    <a href="{{ path('lot_index') }}" class="btn btn-outline-secondary">Annuler</a>
</div>
{{ form_end(form) }}
