{% extends 'base.html.twig' %}
{% block title %}Lots{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 text-forest mb-0"><i class="bi bi-box-seam"></i> Lots de production</h1>
    <a href="{{ path('lot_new') }}" class="btn btn-success"><i class="bi bi-plus-lg"></i> Nouveau lot</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>N° lot</th><th>Pépinière</th><th>Espèce</th><th>Date semis</th>
                    <th>Semées</th><th>Levés</th><th>Germination</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for lot in lots %}
                <tr>
                    <td>{{ lot.numeroLot }}</td>
                    <td>{{ lot.pepiniere ? lot.pepiniere.codePepiniere : '—' }}</td>
                    <td>{{ lot.espece ? lot.espece.nomCommun : '—' }}</td>
                    <td>{{ lot.dateSemis ? lot.dateSemis|date('d/m/Y') : '—' }}</td>
                    <td>{{ lot.nbGrainesSemees ?? '—' }}</td>
                    <td>{{ lot.nbPlantsLeves ?? '—' }}</td>
                    <td><span class="badge bg-success">{{ lot.tauxGermination ?? '—' }} %</span></td>
                    <td class="text-end">
                        <a href="{{ path('lot_edit', {id: lot.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form method="post" action="{{ path('lot_delete_web', {id: lot.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce lot ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ lot.id) }}">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="text-center text-muted py-3">Aucun lot enregistré</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
