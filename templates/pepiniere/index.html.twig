{% extends 'base.html.twig' %}

{% block title %}Pépinières{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 text-forest mb-0"><i class="bi bi-house"></i> Pépinières</h1>
    <a href="{{ path('pepiniere_new') }}" class="btn btn-success"><i class="bi bi-plus-lg"></i> Nouvelle pépinière</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Code</th><th>Nom</th><th>Région</th><th>Village</th>
                    <th>Superficie (m²)</th><th>Capacité/an</th><th>Responsable</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for p in pepinieres %}
                <tr>
                    <td><span class="badge bg-secondary">{{ p.codePepiniere }}</span></td>
                    <td>{{ p.nomPepiniere }}</td>
                    <td>{{ p.region ?? '—' }}</td>
                    <td>{{ p.village ?? '—' }}</td>
                    <td>{{ p.superficieM2 ?? '—' }}</td>
                    <td>{{ p.capaciteProductionAn ?? '—' }}</td>
                    <td>{{ p.responsable ? p.responsable.nom : '—' }}</td>
                    <td class="text-end">
                        <a href="{{ path('pepiniere_show_web', {id: p.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        <a href="{{ path('pepiniere_edit', {id: p.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form method="post" action="{{ path('pepiniere_delete_web', {id: p.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette pépinière ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ p.id) }}">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="text-center text-muted py-3">Aucune pépinière enregistrée</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
