{% extends 'base.html.twig' %}
{% block title %}Suivi de croissance{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 text-forest mb-0"><i class="bi bi-graph-up-arrow"></i> Suivi de croissance</h1>
    <a href="{{ path('croissance_new') }}" class="btn btn-success"><i class="bi bi-plus-lg"></i> Nouvelle mesure</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Date</th><th>Lot</th><th>Hauteur moy. (cm)</th>
                    <th>Diamètre collet (mm)</th><th>Feuilles</th><th>État sanitaire</th>
                    <th>Observations</th><th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for s in suivis %}
                <tr>
                    <td>{{ s.dateMesure|date('d/m/Y') }}</td>
                    <td>{{ s.lot ? s.lot.numeroLot : '—' }}</td>
                    <td>{{ s.hauteurMoyCm ?? '—' }}</td>
                    <td>{{ s.diametreColletMm ?? '—' }}</td>
                    <td>{{ s.nbFeuilles ?? '—' }}</td>
                    <td>
                        {% if s.etatSanitaire %}
                            {% set couleur = {'Sain':'success','Attaque':'warning','Malade':'danger','Faible':'secondary','Mort':'dark'} %}
                            <span class="badge bg-{{ couleur[s.etatSanitaire.value] ?? 'light' }}">{{ s.etatSanitaire.value }}</span>
                        {% else %}—{% endif %}
                    </td>
                    <td class="small text-muted">{{ s.observations ?? '' }}</td>
                    <td class="text-end">
                        <a href="{{ path('croissance_edit', {id: s.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form method="post" action="{{ path('croissance_delete', {id: s.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette mesure ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ s.id) }}">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="text-center text-muted py-3">Aucune mesure enregistrée</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
